# Portfolio Website Environment Variables
# Copy this file to .env and fill in your values (never commit .env to git!)

# ===========================================
# CONTACT FORM - FormSubmit Configuration
# ===========================================
# The email where form submissions are sent
# FormSubmit will send a confirmation email to this address on first submission
FORMSUBMIT_EMAIL=diorbushati@gmail.com

# Optional: Use FormSubmit alias ID instead of plain email in frontend
# 1. Go to https://formsubmit.co and register your email
# 2. You'll get an alias like "abc123" - use that instead of email in form action
# FORMSUBMIT_ALIAS_ID=your-alias-id

# ===========================================
# SPAM PROTECTION - Variante A: FormSubmit Captcha
# ===========================================
# Enable FormSubmit's built-in captcha (adds _captcha=true to form data)
# When enabled, FormSubmit may show a captcha challenge to suspicious submissions
# FORMSUBMIT_CAPTCHA=false

# ===========================================
# SPAM PROTECTION - Variante B: Cloudflare Turnstile (Recommended)
# ===========================================
# Cloudflare Turnstile provides invisible/visible CAPTCHA alternative
# 1. Go to https://dash.cloudflare.com/ → Turnstile
# 2. Create a new site: add your domain (e.g., diorbsh.github.io) AND localhost
# 3. Choose "Managed" or "Non-interactive" widget mode
# 4. Copy Site Key (public) and Secret Key (private)

# Public Site Key - used in frontend (safe to expose in HTML)
# Add this to the meta tag: <meta name="turnstile-site-key" content="YOUR_SITE_KEY">
TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Private Secret Key - ONLY for serverless function (NEVER expose in frontend!)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# ===========================================
# ALTERNATIVE EMAIL DELIVERY (if FormSubmit doesn't work with serverless)
# ===========================================
# Resend (https://resend.com) - modern email API
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# Brevo (formerly Sendinblue) - https://brevo.com
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
# BREVO_FROM_EMAIL=noreply@yourdomain.com